{
  "name": "wireguard-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "electron": "latest",
    "electron-builder": "latest"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "io.nestho.wireguardmanager",
    "productName": "WireGuard Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;Security;",
      "maintainer": "Nestho <63925710+nestho@users.noreply.github.com>",
      "desktopName": "wireguard-manager",
      "syncDesktopName": true
    }
  },
  "description": "Cross-platform WireGuard Manager read-only RouterOS audit desktop client",
  "author": {
    "name": "Nestho",
    "email": "63925710+nestho@users.noreply.github.com"
  }
}
