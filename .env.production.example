# Copy to .env on the production host. Never commit real values.
# Generate a JWT secret: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
WGM_JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Generate with: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
WGM_ENCRYPTION_KEY=REPLACE_WITH_VALID_FERNET_KEY
# Prefer PostgreSQL for production. SQLite is acceptable only for a single-host, low-volume install
# after backup/restore and concurrency testing. Keep DB credentials URL-encoded.
WGM_DATABASE_URL=sqlite:////var/lib/wireguard-manager/wireguard-manager.db
WGM_ACCESS_TOKEN_MINUTES=15
WGM_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME_ADMIN
WGM_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARS
# Exact origin users will access. The app uses same-origin /api proxy.
WGM_ALLOWED_ORIGINS=https://vpn-manager.example.com
WGM_ALLOW_PUBLIC_ROUTER_HOSTS=false
WGM_ALLOW_PUBLIC_LINUX_HOSTS=false
# Keep mutations disabled until tested in a lab with rollback and explicit change approval.
WGM_ENABLE_PEER_MUTATIONS=false
WGM_ENABLE_LINUX_MUTATIONS=false
WGM_ENABLE_LINUX_OPTIMIZER_MUTATIONS=false
