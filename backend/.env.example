# Copy to a protected environment file for local development. Never commit actual secrets.
WGM_DATABASE_URL=sqlite:///./wireguard-manager.db
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
WGM_JWT_SECRET=
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
WGM_ENCRYPTION_KEY=
WGM_ACCESS_TOKEN_MINUTES=15
WGM_BOOTSTRAP_ADMIN_USERNAME=
WGM_BOOTSTRAP_ADMIN_PASSWORD=
WGM_ALLOWED_ORIGINS=http://localhost:5173
# Public hosts are blocked by default. Enable only after network/egress review.
WGM_ALLOW_PUBLIC_ROUTER_HOSTS=false
# Live peer create/revoke endpoints return 503 unless explicitly enabled after testing.
WGM_ENABLE_PEER_MUTATIONS=false
